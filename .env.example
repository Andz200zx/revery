# Demo binds to this computer only. Change APP_MODE to live when connecting Immich.
APP_MODE=demo
HOST=127.0.0.1
PORT=4311
APP_ORIGIN=http://127.0.0.1:4310
# Additional exact HTTPS addresses, e.g. a private Tailscale address alongside a LAN domain.
EXTRA_ORIGINS=
DATA_DIR=./data

# Live mode requires these values. Secrets can alternatively use the *_FILE settings.
IMMICH_URL=
IMMICH_API_KEY=
APP_PASSWORD=
# IMMICH_API_KEY_FILE=/run/secrets/immich_api_key
# APP_PASSWORD_FILE=/run/secrets/app_password

# Link target may differ from the server's internal Immich address.
IMMICH_PUBLIC_URL=
IMMICH_ALTERNATE_URL=
ENABLE_TRASH=false
ENABLE_FAVORITES=true

# Set APP_ORIGIN=https://photos.example.home behind your HTTPS reverse proxy.
# For temporary HTTP LAN use, explicitly opt in with ALLOW_HTTP=true.
ALLOW_HTTP=false
